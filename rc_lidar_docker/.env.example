# cp .env.example .env  후 수정 (Raspberry Pi OS 의 ~/rc_lidar_docker/.env)
# 이미 빌드해 둔 기존 이미지 이름 (docker images 로 확인). 지정하면 재빌드 없이 사용.
RC_IMAGE=rc_lidar_docker:latest
ROS_DOMAIN_ID=0
# 예) 저장 지도 이어서 작성:  RC_LAUNCH_ARGS=map:=/rc_lidar_docker/maps/room1
# 예) 하드웨어만 점검:        RC_LAUNCH_ARGS=slam:=false lidar:=false
RC_LAUNCH_ARGS=
